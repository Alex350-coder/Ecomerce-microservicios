NODE_ENV=development
PORT=3002

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=auth_user
DB_PASSWORD=<set-me>
DB_DATABASE=auth_db
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

JWT_SECRET=<set-me>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
USER_SERVICE_URL=http://localhost:3001

# Seed de desarrollo (npm run seed): credenciales admin + demo
SEED_ADMIN_EMAIL=admin@electroshop.com
SEED_ADMIN_PASSWORD=<set-me-at-least-8-chars>
SEED_DEMO_EMAIL=demo@electroshop.com
SEED_DEMO_PASSWORD=<set-me-at-least-8-chars>
