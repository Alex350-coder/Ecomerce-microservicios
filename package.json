{
  "name": "ecomerce-microservicios",
  "version": "0.0.1",
  "private": true,
  "description": "Orquestación de scripts de Fase 1 (ElectroShop microservicios)",
  "scripts": {
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-all.ps1",
    "up": "docker compose -f docker-compose.yml up -d --build",
    "down": "docker compose -f docker-compose.yml down",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/smoke.ps1"
  }
}
